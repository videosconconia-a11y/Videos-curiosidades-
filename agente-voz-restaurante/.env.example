# Copia este archivo como .env y rellénalo. NUNCA subas el .env a GitHub.

# ── Claude (https://platform.claude.com → API Keys) ──
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODELO=claude-opus-5-5
# low = respuestas más rápidas (recomendado para teléfono). medium/high = más reflexivo pero más lento.
CLAUDE_ESFUERZO=low

# ── Twilio (https://console.twilio.com) ──
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_NUMERO=+34...
# Dirección pública del servidor (la de ngrok o la del hosting), sin barra final.
URL_PUBLICA=https://tu-servidor.ejemplo.com

# Voz española de Twilio. Alternativas: Polly.Sergio-Neural (hombre), Google.es-ES-Neural2-A…
VOZ_TWILIO=Polly.Lucia-Neural
IDIOMA=es-ES

# 1 = enviar SMS de confirmación a móviles españoles tras reservar (cuesta unos céntimos por SMS)
ENVIAR_SMS_CONFIRMACION=0
# 1 = grabar las llamadas (el aviso inicial lo dirá automáticamente)
GRABAR_LLAMADAS=0

# ── Panel del restaurante (/panel) ──
PANEL_USUARIO=admin
PANEL_CLAVE=pon-aqui-una-clave-larga

# Base de datos (por defecto datos/reservas.db)
# BASE_DATOS=/datos/reservas.db
# Archivo de configuración del restaurante (por defecto restaurante.yaml)
# RESTAURANTE_CONFIG=/ruta/restaurante.yaml
